case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  update) shift; cmd_update "$@" ;;
  doctor) cmd_doctor ;;
  completion) shift; cmd_completion "$@" ;;
  --version|-v) shift; cmd_version "$@" ;;
  --help|-h|"") cmd_help ;;
  *) print_red "Unknown command: $1. Run 'dotcontext --help' for usage."; exit 1 ;;
esac
