#!/bin/bash
set -e

VERSION="0.7.0"
REPO="goca-se/dotcontext"
BRANCH="main"
BASE_URL="https://raw.githubusercontent.com/${REPO}/${BRANCH}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
GRAY='\033[0;90m'
CYAN='\033[0;36m'
NC='\033[0m'

# Helper functions
print_green() { printf "${GREEN}%s${NC}\n" "$1"; }
print_red() { printf "${RED}%s${NC}\n" "$1"; }
print_yellow() { printf "${YELLOW}%s${NC}\n" "$1"; }
print_blue() { printf "${BLUE}%s${NC}\n" "$1"; }
print_gray() { printf "${GRAY}%s${NC}\n" "$1"; }
print_cyan() { printf "${CYAN}%s${NC}\n" "$1"; }

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//'
}

prompt() {
  local message="$1"
  local default="$2"
  local result
  if [ -n "$default" ]; then
    printf "%s [%s]: " "$message" "$default" >&2
    read -r result
    echo "${result:-$default}"
  else
    printf "%s: " "$message" >&2
    read -r result
    echo "$result"
  fi
}

confirm() {
  local message="$1"
  local answer
  printf "%s [y/N]: " "$message"
  read -r answer
  [[ "$answer" =~ ^[Yy] ]]
}

download() {
  local url="$1"
  local target="$2"
  if command -v curl &> /dev/null; then
    curl -sSL "$url" -o "$target"
  elif command -v wget &> /dev/null; then
    wget -q "$url" -O "$target"
  else
    print_red "Error: curl or wget required"
    exit 1
  fi
}

# Setup notifications for Claude Code
setup_notifications() {
  local claude_dir="$HOME/.claude"
  local scripts_dir="$claude_dir/scripts"
  local settings_file="$claude_dir/settings.json"
  local notify_script="$scripts_dir/notify.sh"

  # Create scripts directory
  mkdir -p "$scripts_dir"

  # Download and install notify script
  download "${BASE_URL}/scripts/notify.sh" "$notify_script"
  chmod +x "$notify_script"

  # Create or update settings.json with hooks (matcher is string regex, empty = match all)
  local notification_hook='{
    "matcher": "",
    "hooks": [{"type": "command", "command": "~/.claude/scripts/notify.sh '\''Claude Code'\'' '\''Needs your attention'\'' question"}]
  }'
  local stop_hook='{
    "matcher": "",
    "hooks": [{"type": "command", "command": "~/.claude/scripts/notify.sh '\''Claude Code'\'' '\''Task completed'\'' success"}]
  }'

  if [ ! -f "$settings_file" ]; then
    cat > "$settings_file" << 'SETTINGS_EOF'
{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "~/.claude/scripts/notify.sh 'Claude Code' 'Needs your attention' question"}]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "~/.claude/scripts/notify.sh 'Claude Code' 'Task completed' success"}]
      }
    ]
  }
}
SETTINGS_EOF
    print_gray "Notifications configured in ~/.claude/settings.json"
  else
    # Check if hooks already configured
    if ! grep -q "notify.sh" "$settings_file" 2>/dev/null; then
      if command -v jq &>/dev/null; then
        local temp_file=$(mktemp)
        jq --argjson notif "$notification_hook" --argjson stop "$stop_hook" '
          .hooks.Notification = ((.hooks.Notification // []) + [$notif]) |
          .hooks.Stop = ((.hooks.Stop // []) + [$stop])
        ' "$settings_file" > "$temp_file" 2>/dev/null
        if [ $? -eq 0 ] && [ -s "$temp_file" ]; then
          mv "$temp_file" "$settings_file"
          print_gray "Notification hooks added to ~/.claude/settings.json"
        else
          rm -f "$temp_file"
        fi
      else
        print_yellow "Install jq to auto-configure notification hooks, or add manually"
      fi
    fi
  fi
}

# Command: init
cmd_init() {
  local project_name=""
  local skip_prompts=false
  local skip_setup=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--name) project_name="$2"; shift 2 ;;
      -y|--yes) skip_prompts=true; shift ;;
      --no-setup) skip_setup=true; shift ;;
      *) shift ;;
    esac
  done

  print_blue ""
  printf "${BLUE}📁 dotcontext - AI Context Scaffolding${NC}\n\n"

  local cwd="$(pwd)"

  if [ -d ".context" ]; then
    if [ "$skip_prompts" = false ]; then
      if ! confirm ".context already exists. Overwrite?"; then
        print_yellow "Aborted."
        return
      fi
    fi
  fi

  if [ -z "$project_name" ]; then
    if [ "$skip_prompts" = false ]; then
      project_name=$(prompt "Project name" "$(basename "$cwd")")
    else
      project_name="$(basename "$cwd")"
    fi
  fi

  print_gray "Creating structure..."

  # Create directories
  mkdir -p ".context/decisions"
  mkdir -p ".context/skills"
  mkdir -p ".context/prp/templates"
  mkdir -p ".context/prp/generated"
  mkdir -p ".claude/commands"

  # Download templates
  print_gray "Downloading templates..."
  download "${BASE_URL}/templates/CLAUDE.md" "CLAUDE.md"
  download "${BASE_URL}/templates/.context/CONTEXT.md" ".context/CONTEXT.md"
  download "${BASE_URL}/templates/.context/decisions/README.md" ".context/decisions/README.md"
  download "${BASE_URL}/templates/.context/skills/README.md" ".context/skills/README.md"
  download "${BASE_URL}/templates/.context/prp/templates/feature.md" ".context/prp/templates/feature.md"
  download "${BASE_URL}/templates/.claude/commands/setup-context.md" ".claude/commands/setup-context.md"
  download "${BASE_URL}/templates/.claude/commands/code-review.md" ".claude/commands/code-review.md"
  download "${BASE_URL}/templates/.claude/commands/generate-prp.md" ".claude/commands/generate-prp.md"
  download "${BASE_URL}/templates/.claude/commands/execute-prp.md" ".claude/commands/execute-prp.md"
  download "${BASE_URL}/templates/.claude/commands/dotcontext-add-decision.md" ".claude/commands/dotcontext-add-decision.md"
  download "${BASE_URL}/templates/.claude/commands/dotcontext-add-skill.md" ".claude/commands/dotcontext-add-skill.md"
  download "${BASE_URL}/templates/.claude/commands/dotcontext-add-command.md" ".claude/commands/dotcontext-add-command.md"
  touch ".context/prp/generated/.keep"

  # Setup notifications (optional, don't fail if it doesn't work)
  setup_notifications 2>/dev/null || true

  # Substitute project name
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/{{projectName}}/$project_name/g" "CLAUDE.md"
  else
    sed -i "s/{{projectName}}/$project_name/g" "CLAUDE.md"
  fi

  print_green ""
  printf "${GREEN}✅ Context structure created!${NC}\n\n"

  printf "Files created:\n"
  print_gray "  CLAUDE.md"
  print_gray "  .context/"
  print_gray "    ├── CONTEXT.md"
  print_gray "    ├── decisions/"
  print_gray "    ├── skills/"
  print_gray "    └── prp/"
  print_gray "  .claude/"
  print_gray "    └── commands/"
  print_gray "        ├── setup-context.md"
  print_gray "        ├── code-review.md"
  print_gray "        ├── generate-prp.md"
  print_gray "        ├── execute-prp.md"
  print_gray "        ├── dotcontext-add-decision.md"
  print_gray "        ├── dotcontext-add-skill.md"
  print_gray "        └── dotcontext-add-command.md"

  if [ "$skip_setup" = true ]; then
    print_blue ""
    printf "${BLUE}🚀 Next step:${NC}\n"
    printf "  Run /setup-context in Claude Code to populate context files.\n\n"
  else
    print_blue ""
    printf "${BLUE}🤖 Running setup-context...${NC}\n\n"

    if command -v claude &> /dev/null; then
      claude "/setup-context"
    else
      print_yellow "Claude CLI not found. Install it and run /setup-context manually."
      printf "\n"
    fi
  fi

  print_blue "📋 Available commands:\n"
  print_gray "  /setup-context           - Analyze and populate context"
  print_gray "  /generate-prp [feature]  - Plan a new feature"
  print_gray "  /execute-prp [name]      - Implement a planned feature"
  print_gray "  /code-review             - Review code changes"
  print_gray "  /dotcontext-add-decision - Add architectural decision"
  print_gray "  /dotcontext-add-skill    - Add skill guide"
  print_gray "  /dotcontext-add-command  - Add custom command"
  printf "\n"
}

# Migrate hooks from old format to new format
migrate_hooks() {
  local settings_file="$HOME/.claude/settings.json"

  if [ ! -f "$settings_file" ]; then
    return 0
  fi

  # Check if jq is available
  if ! command -v jq &>/dev/null; then
    return 0
  fi

  # Check if file has old format (has "command" directly in hook instead of "hooks" array)
  if jq -e '.hooks | to_entries[] | .value[]? | select(.command != null and .hooks == null)' "$settings_file" >/dev/null 2>&1; then
    print_gray "Migrating hooks to new format..."

    local temp_file=$(mktemp)

    # Convert old format to new format
    jq '
      .hooks = (.hooks | to_entries | map({
        key: .key,
        value: [.value[] | if .hooks then . else {
          matcher: (.matcher // ""),
          hooks: [{type: "command", command: .command}]
        } end]
      }) | from_entries)
    ' "$settings_file" > "$temp_file" 2>/dev/null

    if [ $? -eq 0 ] && [ -s "$temp_file" ]; then
      mv "$temp_file" "$settings_file"
      print_green "✅ Hooks migrated to new format"
    else
      rm -f "$temp_file"
      print_yellow "Could not migrate hooks automatically. See docs for manual migration."
    fi
  fi
}

# Command: update
cmd_update() {
  local update_templates=false
  local force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --templates) update_templates=true; shift ;;
      --force) force=true; shift ;;
      *) shift ;;
    esac
  done

  if [ "$update_templates" = true ]; then
    cmd_update_templates "$force"
  else
    cmd_update_cli
  fi
}

cmd_update_cli() {
  print_blue "Checking for updates..."

  # Get latest version from GitHub (try releases first, then tags)
  local latest_version
  local api_response

  if command -v curl &> /dev/null; then
    # Try releases API first
    api_response=$(curl -sSL "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null)
    latest_version=$(echo "$api_response" | grep '"tag_name"' | head -1 | sed -E 's/.*"([^"]+)".*/\1/' | sed 's/^v//')

    # If no release found, try tags
    if [ -z "$latest_version" ]; then
      api_response=$(curl -sSL "https://api.github.com/repos/${REPO}/tags" 2>/dev/null)
      latest_version=$(echo "$api_response" | grep '"name"' | head -1 | sed -E 's/.*"([^"]+)".*/\1/' | sed 's/^v//')
    fi
  else
    api_response=$(wget -qO- "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null)
    latest_version=$(echo "$api_response" | grep '"tag_name"' | head -1 | sed -E 's/.*"([^"]+)".*/\1/' | sed 's/^v//')

    if [ -z "$latest_version" ]; then
      api_response=$(wget -qO- "https://api.github.com/repos/${REPO}/tags" 2>/dev/null)
      latest_version=$(echo "$api_response" | grep '"name"' | head -1 | sed -E 's/.*"([^"]+)".*/\1/' | sed 's/^v//')
    fi
  fi

  if [ -z "$latest_version" ]; then
    print_yellow "Could not check latest version. Updating anyway..."
    latest_version="unknown"
  else
    if [ "$VERSION" = "$latest_version" ]; then
      print_green "✅ Already at latest version ($VERSION)"
      return 0
    fi
    print_gray "Current: $VERSION → Latest: $latest_version"
  fi

  # Find installation path
  local install_path=$(command -v dotcontext)
  if [ -z "$install_path" ]; then
    install_path="/usr/local/bin/dotcontext"
  fi

  print_gray "Downloading latest version..."

  local tmp_file=$(mktemp)
  download "${BASE_URL}/dotcontext" "$tmp_file"

  # Verify download
  if [ ! -s "$tmp_file" ] || ! head -1 "$tmp_file" | grep -q "^#!/bin/bash"; then
    print_red "Error: Download failed"
    rm -f "$tmp_file"
    return 1
  fi

  chmod +x "$tmp_file"

  # Install
  if [ -w "$(dirname "$install_path")" ]; then
    mv "$tmp_file" "$install_path"
  else
    print_yellow "Need sudo to update $install_path"
    sudo mv "$tmp_file" "$install_path"
    sudo chmod +x "$install_path"
  fi

  print_green "✅ Updated to $latest_version"

  # Run migrations
  migrate_hooks
}

cmd_update_templates() {
  local force="$1"

  if [ ! -d ".context" ]; then
    print_red "No .context directory. Run \`dotcontext init\` first."
    return 1
  fi

  print_blue "Updating templates..."
  print_gray "(only adding new files, not overwriting existing)"

  local added=0
  local skipped=0

  # Define template mappings: remote_path -> local_path
  declare -a templates=(
    "templates/.context/CONTEXT.md:.context/CONTEXT.md"
    "templates/.context/decisions/README.md:.context/decisions/README.md"
    "templates/.context/skills/README.md:.context/skills/README.md"
    "templates/.context/prp/templates/feature.md:.context/prp/templates/feature.md"
    "templates/.claude/commands/setup-context.md:.claude/commands/setup-context.md"
    "templates/.claude/commands/code-review.md:.claude/commands/code-review.md"
    "templates/.claude/commands/generate-prp.md:.claude/commands/generate-prp.md"
    "templates/.claude/commands/execute-prp.md:.claude/commands/execute-prp.md"
    "templates/.claude/commands/dotcontext-add-decision.md:.claude/commands/dotcontext-add-decision.md"
    "templates/.claude/commands/dotcontext-add-skill.md:.claude/commands/dotcontext-add-skill.md"
    "templates/.claude/commands/dotcontext-add-command.md:.claude/commands/dotcontext-add-command.md"
  )

  for mapping in "${templates[@]}"; do
    local remote_path="${mapping%%:*}"
    local local_path="${mapping##*:}"
    local dir_path=$(dirname "$local_path")

    mkdir -p "$dir_path"

    if [ -f "$local_path" ] && [ "$force" != "true" ]; then
      print_gray "  skip: $local_path (exists)"
      ((skipped++))
    else
      if download "${BASE_URL}/${remote_path}" "$local_path" 2>/dev/null; then
        print_green "  added: $local_path"
        ((added++))
      else
        print_red "  failed: $local_path"
      fi
    fi
  done

  # Check for new commands (future-proofing)
  # This fetches a manifest of available commands if we add more later

  echo ""
  if [ $added -gt 0 ]; then
    print_green "✅ Added $added new file(s)"
  fi
  if [ $skipped -gt 0 ]; then
    print_gray "Skipped $skipped existing file(s)"
  fi

  if [ "$force" != "true" ]; then
    echo ""
    print_gray "Use --force to overwrite existing files"
  fi
}

# Command: help
cmd_help() {
  cat << 'EOF'
dotcontext - Scaffold AI context structure for your codebase

Usage:
  dotcontext <command> [options]

Commands:
  init                Initialize .context structure + open Claude Code
  update              Update dotcontext CLI to latest version
  update --templates  Add new templates (won't overwrite existing)

Options:
  --help, -h          Show this help message
  --version, -v       Show version number

Init Options:
  --name, -n <name>   Project name
  --yes, -y           Skip prompts and use defaults
  --no-setup          Skip automatic /setup-context execution

Update Options:
  --templates         Update templates in current project
  --force             Overwrite existing files (use with --templates)

Examples:
  dotcontext init
  dotcontext init --name "My Project"
  dotcontext init --no-setup
  dotcontext update
  dotcontext update --templates

Claude Code Commands (after init):
  /setup-context              Analyze codebase and populate context
  /generate-prp [feature]     Plan a new feature with clarifying questions
  /execute-prp [name]         Implement a planned feature
  /code-review                Review code changes
  /dotcontext-add-decision    Add and populate an ADR interactively
  /dotcontext-add-skill       Add and populate a skill guide
  /dotcontext-add-command     Create a custom slash command
EOF
}

# Main routing
case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  update) shift; cmd_update "$@" ;;
  --version|-v) echo "dotcontext $VERSION" ;;
  --help|-h|"") cmd_help ;;
  *) print_red "Unknown command: $1. Run 'dotcontext --help' for usage."; exit 1 ;;
esac
