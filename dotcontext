else
  RED='' GREEN='' YELLOW='' BLUE='' PURPLE='' CYAN='' GRAY='' BOLD='' DIM='' NC=''
fi

# Helper print functions
print_green() { printf "${GREEN}%s${NC}\n" "$1"; }
